# Keep the build context small and the image clean.
#
# ⚠ database/database.sqlite is the DEVELOPMENT database and must never reach a
# production image. It contains dev employees, dev salary structures and a dev
# payroll run.

.git
.github
node_modules
vendor
public/build
public/hot
storage/app/private
storage/app/public
storage/logs
storage/framework/cache
storage/framework/sessions
storage/framework/testing
storage/framework/views
bootstrap/cache/*.php

database/database.sqlite
database/*.sqlite
.env
.env.*
# ⚠⚠ A bare `.env` matches only the ROOT file, and the Dockerfile does
# `COPY . .`, so deploy/.env (the production secrets) would be baked into the
# image (audit, 13 Oct 2026). Every .env, at any depth, stays out.
**/.env
**/.env.*
deploy/.env
!deploy/.env.example

tests
.phpunit.result.cache
phpunit.xml

deploy/*.md
*.log
.DS_Store
Thumbs.db

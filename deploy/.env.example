# Production environment for the Bor De Guna ERP stack.
#
# Copy to /opt/bordeguna-erp/.env on the server and fill in the secrets.
# ⚠ This file is the example. The real .env is NEVER committed and never leaves
# the server.

APP_NAME="Bor De Guna ERP"
APP_ENV=production
APP_KEY=
# Generate on the server: docker compose run --rm app php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://erp.srv1808022.hstgr.cloud

# ⚠ Asia/Dhaka, not UTC. The business runs on Dhaka time and the payroll period
# boundary (24th → 23rd) is a date comparison — an app on UTC put device punches
# and web clock-ins six hours apart in the same column.
APP_TIMEZONE=Asia/Dhaka

# ⚠ Trusted proxies are NOT configured here. On Laravel 11/12 a TRUSTED_PROXIES
# env var does nothing at all — it is a leftover convention from the old
# TrustProxies middleware class. The real configuration is `trustProxies()` in
# bootstrap/app.php, and without it every page renders BLANK in production:
# Laravel builds http:// asset URLs on an https:// page and the browser blocks
# every script as mixed content. This comment exists because that is exactly
# what shipped on 2026-07-29.

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=bordeguna_erp
DB_USERNAME=bordeguna
DB_PASSWORD=
DB_ROOT_PASSWORD=
# ⚠ Both passwords must be set before the first `up`. MySQL initialises its data
# directory once, on first start, and changing these afterwards does NOT change
# the credentials inside the volume.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# ⚠ The database queue, not sync. Payroll calculation, queued reports and
# payslip email all depend on a real worker — with `sync` they would run inside
# the web request and time out.
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mail. Payslip delivery and approval notifications both use this.
#
# Nikolahost cPanel mailbox on bordeguna.com (that domain is on the cPanel
# account, not on this VPS — mail leaves the box entirely).
#
# ⚠ Port 465 is implicit TLS, so MAIL_ENCRYPTION=ssl. Using 'tls' here would
# make the client attempt STARTTLS on a port that expects TLS from the first
# byte, and the connection fails with an unhelpful timeout rather than an
# authentication error.
MAIL_MAILER=smtp
MAIL_HOST=mail.bordeguna.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=noreply@bordeguna.com
MAIL_PASSWORD=
# ⚠⚠ LEAVE THIS BLANK. THIS FILE IS COMMITTED AND PUSHED TO GITHUB.
#
# A real password was pasted here once, on 2026-07-29, and was caught in the
# working tree before it was staged. It would have been public in the repository
# history the moment it was pushed, and history is far harder to clean than a
# file. The live value belongs only in /opt/bordeguna-erp/.env on the server,
# which is chmod 600 and not in git.
MAIL_FROM_ADDRESS="noreply@bordeguna.com"
MAIL_FROM_NAME="${APP_NAME}"

# ⚠ The EHLO domain is derived from APP_URL, which is erp.srv1808022.hstgr.cloud
# — a different host from the sending domain. Some providers reject that. If
# mail is refused, set this to bordeguna.com explicitly.
# MAIL_EHLO_DOMAIN=bordeguna.com

VITE_APP_NAME="${APP_NAME}"

# ⚠⚠ THE DATE SCHEDULE ASSIGNMENTS BECOME EFFECTIVE FROM.
#
# BorDeGunaAttendanceSeeder defaults this to "today", which is harmless only
# while no attendance exists. The moment days are backfilled, an assignment
# dated later than those days means NO SHIFT RESOLVES for them - so nothing is
# judged late, silently and with no error.
#
# Found on 2026-07-29: assignments were seeded on the 29th while the backfill
# covers 24-29 July, so every backfilled day would have been recorded with no
# punctuality assessment at all. Set to the payroll cycle start.
HRM_GO_LIVE_DATE=2026-07-24

# --- Offsite backup: Backblaze B2 via restic -------------------------------
#
# ⚠⚠ RESTIC_PASSWORD IS THE ONLY KEY TO THE OFFSITE BACKUPS. Backblaze cannot
# recover it and neither can anyone else. Lose it and every offsite copy is
# permanently unreadable, including the ones that already exist. It must be
# stored in a password manager OFF this server -- a copy that lives only beside
# the data it protects is not a second copy of anything.
#
# ⚠ The B2 application key should be scoped to the backup bucket ALONE, not a
# master key. A key that can only write to one bucket cannot be used to reach
# anything else if this server is compromised.
#
# ⚠ Turn on Object Lock / file retention on the bucket if you can. Without it,
# anyone who gets root here can delete the offsite copies too, and ransomware
# does exactly that.
#
# Repository form: b2:<bucket-name>:<path-inside-bucket>
RESTIC_REPOSITORY=b2:bordeguna-erp-backup:erp
RESTIC_PASSWORD=
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
